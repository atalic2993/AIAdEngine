# Site
NEXT_PUBLIC_SITE_URL=https://aiadengine.co.za
NEXT_PUBLIC_CONTACT_EMAIL=support@aiadengine.co.za

# PayFast (recurring monthly subscriptions)
# Leave PAYFAST_SANDBOX=true until the live credentials are in place.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# In sandbox the published test passphrase (jt7NOE43FZPn) is used automatically.
PAYFAST_PASSPHRASE=

# Tracking (each pixel stays off until its ID is filled in)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Meta Conversions API (server-side purchase events from the PayFast notification)
META_CAPI_ACCESS_TOKEN=

# GoHighLevel webhook
# Fires from the PayFast notification once a subscription payment completes, with
# every detail the customer entered at checkout.
# Leave blank to use the address baked into lib/ghl.ts.
GHL_PURCHASE_WEBHOOK_URL=
